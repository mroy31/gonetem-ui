{
  "compilerOptions": {
    "jsx": "react",
    "allowJs": true,
    "module": "esnext",
    "lib": ["DOM", "es2021"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "target": "ES2021",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "types/*",
    "src/**/*"
  ]
}
